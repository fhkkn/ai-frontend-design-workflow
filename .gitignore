# Publish only the reviewed workflow documents.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/AI前端设计工作手册.md
!/templates/
!/templates/*.md
!/guides/
!/guides/*.md
!/prompts/
!/prompts/*.md
!/skills/
!/skills/frontend-divergent-design/
!/skills/frontend-divergent-design/SKILL.md
!/skills/frontend-divergent-design/agents/
!/skills/frontend-divergent-design/agents/openai.yaml
!/skills/frontend-divergent-design/scripts/
!/skills/frontend-divergent-design/scripts/draw.py
!/skills/project-change-review/
!/skills/project-change-review/SKILL.md
!/examples/
/examples/*
!/examples/landscape/
!/examples/landscape/**

# Keep local data and tooling out of every published directory.
**/.env*
**/node_modules/
**/.local/
**/*.log
**/.DS_Store
**/__pycache__/
